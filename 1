@app.get("/users/add", response_class=HTMLResponse)
def add_user_form(request: Request):
    return render_form(request, "add", {"name": "", "email": ""}, [])


@app.post("/users/add")
def add_user_submit(
    request: Request,
    name: str = Form(""),
    email: str = Form(""),
    password: str = Form(""),
):
    values = {"name": name, "email": email}
    try:
        data = UserCreate(name=name, email=email, password=password)
    except ValidationError as exc:
        return render_form(request, "add", values, error_messages(exc), 400)
    try:
        create_user(data.name, data.email, data.password)
    except EmailExistsError:
        return render_form(request, "add", values, ["Email đã tồn tại."], 400)
    return RedirectResponse("/users?msg=created", status_code=303)


