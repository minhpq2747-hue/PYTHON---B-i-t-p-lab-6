pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")


def hash_password(password):
    return pwd_context.hash(password)


def verify_password(password, hashed):
    return pwd_context.verify(password, hashed)


def init_db():
    connection = mysql.connector.connect(**DB_CONFIG)
    try:
        cursor = connection.cursor()
        cursor.execute(
            f"CREATE DATABASE IF NOT EXISTS `{DB_NAME}` "
            "CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
        )
        cursor.execute(f"USE `{DB_NAME}`")
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS users (
                id INT AUTO_INCREMENT PRIMARY KEY,
                name VARCHAR(100) NOT NULL,
                email VARCHAR(255) NOT NULL UNIQUE,
                password VARCHAR(255) NOT NULL,
                created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
            ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
            """
        )
        connection.commit()
        cursor.close()
    finally:
        connection.close()


@contextmanager
def get_cursor(commit=False):
    connection = mysql.connector.connect(**DB_CONFIG, database=DB_NAME)
    cursor = connection.cursor(dictionary=True)
    try:
        yield cursor
        if commit:
            connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        cursor.close()
        connection.close()


EMAIL_PATTERN = re.compile(r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")


def check_name(value):
    value = value.strip()
    if not value:
        raise ValueError("Tên không được để trống.")
    if len(value) > 100:
        raise ValueError("Tên tối đa 100 ký tự.")
    return value


def check_email(value):
    value = value.strip().lower()
    if len(value) > 255 or not EMAIL_PATTERN.match(value):
        raise ValueError("Email không hợp lệ.")
    return value


def check_password(value):
    if len(value) < 6:
        raise ValueError("Mật khẩu phải có ít nhất 6 ký tự.")
    if len(value.encode("utf-8")) > 72:
        raise ValueError("Mật khẩu tối đa 72 byte.")
    return value


class UserCreate(BaseModel):
    name: str
    email: str
    password: str

    @field_validator("name")
    @classmethod
    def validate_name(cls, value):
        return check_name(value)

    @field_validator("email")
    @classmethod
    def validate_email(cls, value):
        return check_email(value)

    @field_validator("password")
    @classmethod
    def validate_password(cls, value):
        return check_password(value)


class UserUpdate(BaseModel):
    name: Optional[str] = None
    email: Optional[str] = None
    password: Optional[str] = None

    @field_validator("name")
    @classmethod
    def validate_name(cls, value):
        return value if value is None else check_name(value)

    @field_validator("email")
    @classmethod
    def validate_email(cls, value):
        return value if value is None else check_email(value)

    @field_validator("password")
    @classmethod
    def validate_password(cls, value):
        return value if value is None else check_password(value)


class UserOut(BaseModel):
    id: int
    name: str
    email: str
    created_at: datetime
    created_at_display: str


class EmailExistsError(Exception):
    pass


class UserNotFoundError(Exception):
    pass


COLUMNS = "id, name, email, created_at"


def prepare(row):
    if row is None:
        return None
    row["created_at_display"] = row["created_at"].strftime("%d/%m/%Y %H:%M")
    return row


def get_users():
    with get_cursor() as cursor:
        cursor.execute(f"SELECT {COLUMNS} FROM users ORDER BY id")
        return [prepare(row) for row in cursor.fetchall()]


def get_user(user_id):
    with get_cursor() as cursor:
        cursor.execute(f"SELECT {COLUMNS} FROM users WHERE id = %s", (user_id,))
        return prepare(cursor.fetchone())


def email_taken(email, exclude_id=None):
    with get_cursor() as cursor:
        if exclude_id is None:
            cursor.execute("SELECT id FROM users WHERE email = %s", (email,))
        else:
            cursor.execute(
                "SELECT id FROM users WHERE email = %s AND id <> %s", (email, exclude_id)
            )
        return cursor.fetchone() is not None


def create_user(name, email, password):
    name = name.strip()
    email = email.strip().lower()
    if email_taken(email):
        raise EmailExistsError(email)
    try:
        with get_cursor(commit=True) as cursor:
            cursor.execute(
                "INSERT INTO users (name, email, password) VALUES (%s, %s, %s)",
                (name, email, hash_password(password)),
            )
            new_id = cursor.lastrowid
    except IntegrityError as exc:
        if exc.errno == errorcode.ER_DUP_ENTRY:
            raise EmailExistsError(email)
        raise
    logger.info("Thêm người dùng id=%s, email=%s", new_id, email)
    return get_user(new_id)


def update_user(user_id, name=None, email=None, password=None):
    current = get_user(user_id)
    if current is None:
        raise UserNotFoundError(user_id)
    fields = []
    values = []
    changed = []
    if name is not None:
        fields.append("name = %s")
        values.append(name.strip())
        changed.append("name")
    if email is not None:
        email = email.strip().lower()
        if email_taken(email, user_id):
            raise EmailExistsError(email)
        fields.append("email = %s")
        values.append(email)
        changed.append("email")
    if password is not None:
        fields.append("password = %s")
        values.append(hash_password(password))
        changed.append("password")
    if not fields:
        return current
    values.append(user_id)
    try:
        with get_cursor(commit=True) as cursor:
            cursor.execute(
                f"UPDATE users SET {', '.join(fields)} WHERE id = %s", tuple(values)
            )
    except IntegrityError as exc:
        if exc.errno == errorcode.ER_DUP_ENTRY:
            raise EmailExistsError(email)
        raise
    logger.info("Sửa người dùng id=%s, các trường: %s", user_id, ", ".join(changed))
    return get_user(user_id)


def delete_user(user_id):
    current = get_user(user_id)
    if current is None:
        raise UserNotFoundError(user_id)
    with get_cursor(commit=True) as cursor:
        cursor.execute("DELETE FROM users WHERE id = %s", (user_id,))
    logger.info("Xóa người dùng id=%s, email=%s", user_id, current["email"])


