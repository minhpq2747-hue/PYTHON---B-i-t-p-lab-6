    "notfound": ("warning", "Không tìm thấy người dùng."),
}


@asynccontextmanager
async def lifespan(app):
    init_db()
    yield


app = FastAPI(title="Hệ thống quản lý người dùng", lifespan=lifespan)
templates = Jinja2Templates(
    env=Environment(loader=DictLoader(TEMPLATES), autoescape=True)
)


@app.exception_handler(mysql.connector.Error)
async def database_error_handler(request, exc):
    logger.error("Lỗi cơ sở dữ liệu: %s", exc)
    return JSONResponse(status_code=500, content={"detail": "Lỗi cơ sở dữ liệu."})


def error_messages(exc):
    return [error["msg"].removeprefix("Value error, ") for error in exc.errors()]


def render_form(request, mode, user, errors, status_code=200):
    return templates.TemplateResponse(
        request,
        "user_form.html",
        {"mode": mode, "user": user, "errors": errors},
        status_code=status_code,
    )


@app.get("/api/users", response_model=list[UserOut])
def api_list_users():
    return get_users()


@app.get("/api/users/{user_id}", response_model=UserOut)
def api_get_user(user_id: int):
    user = get_user(user_id)
    if user is None:
        raise HTTPException(status_code=404, detail="Không tìm thấy người dùng.")
    return user


@app.post("/api/users", response_model=UserOut, status_code=201)
def api_create_user(data: UserCreate):
    try:
        return create_user(data.name, data.email, data.password)
    except EmailExistsError:
        raise HTTPException(status_code=409, detail="Email đã tồn tại.")


@app.put("/api/users/{user_id}", response_model=UserOut)
def api_update_user(user_id: int, data: UserUpdate):
    try:
        return update_user(user_id, **data.model_dump(exclude_none=True))
    except UserNotFoundError:
        raise HTTPException(status_code=404, detail="Không tìm thấy người dùng.")
    except EmailExistsError:
        raise HTTPException(status_code=409, detail="Email đã tồn tại.")


@app.delete("/api/users/{user_id}")
def api_delete_user(user_id: int):
    try:
        delete_user(user_id)
    except UserNotFoundError:
        raise HTTPException(status_code=404, detail="Không tìm thấy người dùng.")
    return {"detail": "Đã xóa người dùng."}


