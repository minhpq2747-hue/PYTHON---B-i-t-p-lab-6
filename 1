@app.post("/users/edit/{user_id}")
def edit_user_submit(
    request: Request,
    user_id: int,
    name: str = Form(""),
    email: str = Form(""),
    password: str = Form(""),
):
    values = {"id": user_id, "name": name, "email": email}
    payload = {"name": name, "email": email}
    if password:
        payload["password"] = password
    try:
        data = UserUpdate(**payload)
    except ValidationError as exc:
        return render_form(request, "edit", values, error_messages(exc), 400)
    try:
        update_user(user_id, **data.model_dump(exclude_none=True))
    except UserNotFoundError:
        return RedirectResponse("/users?msg=notfound", status_code=303)
    except EmailExistsError:
        return render_form(request, "edit", values, ["Email đã tồn tại."], 400)
    return RedirectResponse("/users?msg=updated", status_code=303)


